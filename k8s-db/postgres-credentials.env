# Fuente unica de verdad de las credenciales de PostgreSQL.
# Kustomize genera desde aqui el mismo Secret en dos namespaces:
#   - postgres-credentials       (namespace databases)  -> entrypoint de Postgres
#   - postgres-credentials-apps  (namespace apps)       -> order-service / tracking-service
# Formato .env de kustomize: KEY=value, comentarios con '#'.
POSTGRES_USER=quarkusdbuser
POSTGRES_PASSWORD=Java360445
POSTGRES_DB=cloudnative-db
