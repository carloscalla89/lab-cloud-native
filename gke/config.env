# Configuracion del cluster GKE (GCP).
# Mantener PROJECT_ID y REGION sincronizados con artifact/config.env.
export PROJECT_ID="training-lab-504513"
export REGION="us-central1"          # region de recursos (Artifact Registry, IP global)
export ZONE="us-central1-a"          # cluster ZONAL. Vacio -> cluster regional
export NODE_LOCATIONS=""             # solo si regional: "us-central1-a,us-central1-b"
export CLUSTER_NAME="lab-cloudnative"
export RELEASE_CHANNEL="regular"
export NODE_COUNT="1"                # nodos (por zona)
export MACHINE_TYPE="e2-standard-2"
export MACHINE_TYPES_FALLBACK="e2-standard-4 n2-standard-2"   # por si falta capacidad
export SPOT="false"                  # true -> nodos spot (mas baratos, desalojables)
export GATEWAY_IP_NAME="apps-gateway-ip"
