# Via gateway (recomendado): port-forward al ingress gateway de Istio.
#   kubectl -n istio-ingress port-forward svc/apps-gateway-istio 8080:80
# El proxy de Vite reescribe /bff -> '' y reenvia a esta URL, asi las llamadas
# pasan por Istio (mTLS + AuthorizationPolicy) y no hay CORS.
VITE_BFF_URL=http://localhost:8080

# Alternativa directa al BFF (bypasea Istio, solo para debug):
#   kubectl -n apps port-forward svc/experience-order-tracker-service 8082:8082
# VITE_BFF_URL=http://localhost:8082
